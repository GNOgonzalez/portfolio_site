---
import type { ProjectArchitecture } from '../data/architecture';

interface Props {
  architecture: ProjectArchitecture;
  id: string;
}

const { architecture, id } = Astro.props;
const dataId = `architecture-data-${id}`;
const hostId = `architecture-host-${id}`;
---

<section class="architecture" id="architecture" aria-labelledby={`architecture-heading-${id}`}>
  <h2 id={`architecture-heading-${id}`}>{architecture.title}</h2>
  <p class="architecture-caption">{architecture.caption}</p>

  <figure class="diagram card" aria-labelledby={`architecture-heading-${id}`}>
    <template id={dataId}>{architecture.diagram}</template>
    <div id={hostId} class="diagram-host" data-diagram-id={id}>
      <p class="diagram-loading">Loading diagram…</p>
    </div>
  </figure>
</section>

<script>
  import mermaid from 'mermaid';

  const themeVariables = {
    fontFamily: 'Inter, Segoe UI, system-ui, sans-serif',
    fontSize: '14px',
    primaryColor: '#eef3f6',
    primaryBorderColor: '#3d6a85',
    primaryTextColor: '#0f1c24',
    secondaryColor: '#d9e8f0',
    secondaryBorderColor: '#3d6a85',
    secondaryTextColor: '#0f1c24',
    tertiaryColor: '#ffffff',
    tertiaryBorderColor: '#7eb3cf',
    tertiaryTextColor: '#0f1c24',
    lineColor: '#3d6a85',
    textColor: '#0f1c24',
    mainBkg: '#eef3f6',
    nodeBorder: '#3d6a85',
    clusterBkg: '#f8fbfd',
    clusterBorder: '#c5d4de',
    titleColor: '#254656',
    edgeLabelBackground: '#ffffff',
  };

  mermaid.initialize({
    startOnLoad: false,
    theme: 'base',
    securityLevel: 'strict',
    themeVariables,
  });

  async function renderDiagrams() {
    const hosts = document.querySelectorAll<HTMLElement>('.diagram-host');

    for (const host of hosts) {
      const diagramId = host.dataset.diagramId;
      if (!diagramId || host.dataset.rendered === 'true') continue;

      const template = document.getElementById(`architecture-data-${diagramId}`);
      const diagram =
        template instanceof HTMLTemplateElement
          ? template.content.textContent?.trim()
          : undefined;

      if (!diagram) continue;

      try {
        const { svg } = await mermaid.render(`architecture-${diagramId}`, diagram);
        host.innerHTML = svg;
        host.setAttribute('role', 'img');
        host.dataset.rendered = 'true';
      } catch {
        host.innerHTML = '<p class="diagram-error">Could not render architecture diagram.</p>';
      }
    }
  }

  renderDiagrams();
</script>

<style>
  .architecture {
    margin-top: var(--space-xl);
    max-width: none;
  }

  h2 {
    margin: 0 0 var(--space-md);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .architecture-caption {
    max-width: var(--reading-width);
    margin: 0 0 var(--space-lg);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .diagram {
    margin: 0;
    padding: var(--space-lg);
    overflow-x: auto;
  }

  .diagram-host {
    min-height: 12rem;
  }

  .diagram-loading,
  .diagram-error {
    margin: 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .diagram-host :global(svg) {
    display: block;
    width: 100%;
    min-width: 20rem;
    height: auto;
    margin-inline: auto;
  }
</style>
