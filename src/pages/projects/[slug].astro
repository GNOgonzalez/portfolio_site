---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import DemoButton from '../../components/DemoButton.astro';
import ProjectOverview from '../../components/ProjectOverview.astro';
import ProjectNav from '../../components/ProjectNav.astro';
import DemoGuide from '../../components/DemoGuide.astro';
import InquiryLink from '../../components/InquiryLink.astro';
import Footer from '../../components/Footer.astro';
import { getProject, getSortedProjects, getAdjacentProjects } from '../../data/projects';
import { getDemoGuide } from '../../data/demo-guides';

export function getStaticPaths() {
  return getSortedProjects().map((project) => ({
    params: { slug: project.slug },
  }));
}

const { slug } = Astro.params;
const project = getProject(slug!);

if (!project) {
  throw new Error(`Unknown project slug: ${slug}`);
}

const { prev, next } = getAdjacentProjects(slug!);
const demoGuide = getDemoGuide(slug!);
const orderLabel = String(project.order).padStart(2, '0');

const statusLabels: Record<typeof project.status, string> = {
  live: 'Live demo',
  shipped: 'Shipped',
  'on-hold': 'On hold',
  'coming-soon': 'Demo coming soon',
  'in-progress': 'In progress',
};

const pageTitle = `${project.title} — Gino M. Gonzalez`;
---

<Layout title={pageTitle} description={project.subtitle}>
  <Header />
  <main id="main" class="project-page">
    <article class="section container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true"> / </span>
        <a href="/#projects">Projects</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{project.title}</span>
      </nav>

      <header class="project-header">
        <p class="order-label">Project {orderLabel}</p>
        <p class="status">{statusLabels[project.status]}</p>
        <h1>{project.title}</h1>
        <p class="subtitle">{project.subtitle}</p>
        <ul class="tag-list stack" aria-label="Tech stack">
          {project.stack.map((tech) => (
            <li><span class="tag">{tech}</span></li>
          ))}
        </ul>
        <div class="header-actions">
          {project.demoUrl ? (
            <DemoButton href={project.demoUrl} label="Launch demo" />
          ) : project.demoNote ? (
            <span class="demo-pending text-muted">{project.demoNote}</span>
          ) : null}
          {
            demoGuide?.inquiry && (
              <InquiryLink label="Send an inquiry" variant="secondary" />
            )
          }
          {
            project.githubUrl && (
              <a
                class="btn btn-secondary"
                href={project.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                GitHub
                <span class="sr-only"> (opens in new tab)</span>
              </a>
            )
          }
        </div>
        {project.demoUrl && project.demoNote && (
          <p class="demo-note text-muted">{project.demoNote}</p>
        )}
        {project.githubNote && <p class="github-note text-muted">{project.githubNote}</p>}
      </header>

      <ProjectOverview project={project} />

      {demoGuide && <DemoGuide guide={demoGuide} demoUrl={project.demoUrl} />}

      <ProjectNav prev={prev} next={next} />
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .project-page .section {
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .breadcrumb {
    margin-bottom: var(--space-lg);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .breadcrumb a {
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .project-header {
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .order-label {
    margin: 0 0 var(--space-xs);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-bright);
  }

  .status {
    margin: 0 0 var(--space-sm);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  h1 {
    margin: 0 0 var(--space-sm);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .subtitle {
    margin: 0 0 var(--space-md);
    font-size: 1.0625rem;
    color: var(--color-primary-dark);
    font-weight: 500;
  }

  .stack {
    margin-bottom: var(--space-lg);
  }

  .header-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
  }

  .demo-pending,
  .demo-note {
    font-size: 0.9375rem;
  }

  .demo-note {
    margin: var(--space-sm) 0 0;
  }

  .github-note {
    margin: var(--space-sm) 0 0;
    font-size: 0.875rem;
  }
</style>
